# tetris 构建期环境变量（复制到 .env 后填值；会被 build.mjs 注入为构建期常量）
# 若 bin/index.html 里已写入运行时 window.__APP_ENV__，则以运行时为准，这里可留空。
# 优先级：运行时 window.__APP_ENV__  >  构建期 process.env.*  >  内置默认值

# 共享 Nest 后端（game-server）地址，前端据此拼 /api/client/v1/tetris/* 与 /api/client/v1/auth/*
GAME_SERVER_API_URL=https://game.yourbao.cn

# zhao-sso 统一登录页（h.joho.cn 上的 SSO 中转）
SSO_LOGIN_URL=https://h.joho.cn/#/pages/sso/login

# 方块游戏专属 SSO 应用编码（需在 zhao-sso 注册，与消消乐 game-xxl 隔离）
SSO_APP_CODE=game-tetris

# 本站对外地址（分享链接基址；子路径部署填 https://game.yourbao.cn/tetris/）
SITE_URL=https://game.yourbao.cn/tetris/

# 消消乐分享裂变（方块暂不接入，留空）
MARKETING_API_BASE=
MARKETING_CAMPAIGN_CODE=
