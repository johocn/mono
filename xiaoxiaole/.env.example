# Vendure 商品 / 促销真实数据源配置
#
# 使用方式：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填入你的 Vendure Shop API 地址（通常为 https://你的域名/shop-api）
#   3. 重新构建：  npm run build
#
# 留空（或不创建 .env）则游戏使用本地 mock 商品，演示 / 联调不依赖真实后端。
# 也可不重新构建：在 bin/index.html 的 window.__APP_ENV__ 中直接注入（部署时由网关注入更方便）。

# Vendure Shop API 地址（必填才启用真实数据源；非 http(s) 时自动回退 mock）
VENDURE_API_URL=

# Vendure 商城前台地址（用于拼接商品落地页，可选，默认占位域名）
VENDURE_STOREFRONT_URL=https://shop.braingarden.example

# 渠道令牌（公开商品查询通常不需要；私有 / 带鉴权接口才填）
VENDURE_CHANNEL_TOKEN=

# 消消乐后端（game-server）地址，用于换装花园：模板中心 / AI 生成 / 素材上传 / 积分同步
# 例：http://localhost:3000 或 https://your-game-server
# 留空则游戏为「本地模式」：换肤、本地皮肤库、分享码、本地积分全部可用，
# 仅 AI 生成与云端模板中心降级并给出提示，主玩法不受影响。
GAME_SERVER_API_URL=

# 营销 A/B 分享统计（Strapi zhao-studio / zhao-track 宿主）
# 留空则自动跳过营销分享逻辑，游戏保持原有分享行为
MARKETING_API_BASE=
# 营销活动 code（promo-campaign.code，须与后台录入完全一致；URL ?camp= 可临时覆盖）
MARKETING_CAMPAIGN_CODE=

# 家属同步接口地址（接收周报 / 未练习状态，供子女查看）
# 例：https://h.joho.cn
# 留空则保持纯离线：家属页的月报/周报/分享照常可用，只是不上传任何数据。
# 上报内容仅为「亲情码 + 聚合数值」（综合指数 / 近 7 天训练天数 / 未练习天数 / 最弱认知域），
# 不含姓名、手机号等任何可识别个人信息。
FAMILY_SYNC_API_URL=
